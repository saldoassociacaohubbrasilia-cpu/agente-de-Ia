# Copie este arquivo pra ".env" e preencha com os valores reais.
# NUNCA suba o .env de verdade pro GitHub (já tem que estar no .gitignore).

# --- Autenticação ---
SECRET_KEY=troque_por_uma_chave_gerada_com_secrets.token_hex
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Banco de dados (professores, chamados, planilhas) ---
DATABASE_URL=sqlite:///./teachers.db

# --- Qdrant (banco vetorial na AWS) ---
QDRANT_URL=http://SEU_IP_PUBLICO_EC2:6333
QDRANT_API_KEY=a_mesma_chave_que_voce_colocou_no_ec2_user_data.sh
QDRANT_COLLECTION_NAME=materiais_pedagogicos

# --- Google Gemini (chat + embeddings) ---
# Gere a chave em https://aistudio.google.com/apikey
GOOGLE_API_KEY=...
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# --- CORS ---
CORS_ORIGINS=http://localhost:5500,https://seu-usuario.github.io

# --- E-mail (abertura de chamado) ---
# Exemplo com Gmail: crie uma "senha de app" em myaccount.google.com/apppasswords
# (não dá pra usar a senha normal da conta com SMTP).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua_senha_de_app
SMTP_FROM=seu-email@gmail.com
SUPPORT_EMAIL_TO=suporte@seuprograma.org

# --- Relatório de turma (opcional) ---
# Se preenchido, o relatório busca dado ao vivo na API do Saldo+. Se
# deixar em branco, o relatório usa a última planilha carregada.
SALDO_API_BASE_URL=
